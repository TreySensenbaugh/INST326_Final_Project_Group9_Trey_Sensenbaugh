import json


class GameState:
    """
    Purpose:
        store the game state

    Arguments:
        scene_id: the current scene
        risk: current risk amount
        progress: current progress amount
        resources: current resources amount

    Returns:
        none

    Author:
        Sensenbaugh
    """
    def __init__(self, scene_id, risk=0, progress=0, resources=5):
        """
        Purpose:
            set up the game state 

        Arguments:
            scene_id: the current scene
            risk: current risk amount
            progress: current progress amount
            resources: current resources amount

        Returns:
            none

        Author:
            Sensenbaugh
        """
        self.scene_id = scene_id
        self.risk = risk
        self.progress = progress
        self.resources = resources
        self.flags = {}
        self.history = []

    def show_stats(self):
        """
        Purpose:
            show the player stats

        Arguments:
            none

        Returns:
            none

        Author:
            Antil
        """
        print()
        print("Risk:", self.risk)
        print("Progress:", self.progress)
        print("Resources:", self.resources)
        print()


def load_scenes(filename):
    """
    Purpose:
        load the scenes from the json file

    Arguments:
        filename: the file name to open

    Returns:
        list: the scenes from the file

    Author:
        Balfour
    """
    with open(filename, "r", encoding="utf-8") as f:
        return json.load(f)["scenes"]
    
    
def get_scene_by_id(scenes, scene_id):
    """
    Purpose:
        find the scene that matches the id

    Arguments:
        scenes: all the scenes
        scene_id: the id to look for

    Returns:
        dict or None: the scene if found, or none if not

    Author:
        Coogan
    """
    for scene in scenes:
        if scene["id"] == scene_id:
            return scene
    return None


def requirements_met(choice, state):
    """
    Purpose:
        check if the player can use a choice

    Arguments:
        choice: the choice being checked
        state: current game state

    Returns:
        bool: true if the choice can be used, false if not

    Author: Antil
        
    """
    if "requires" not in choice:
        return True

    reqs = choice["requires"]

    for key, value in reqs.items():
        if key == "min_resources":
            if state.resources < value:
                return False
        elif key == "max_risk":
            if state.risk > value:
                return False
        else:
            if state.flags.get(key) != value:
                return False

    return True
    
    
def get_choices(scene, state):
    """
    Purpose:
        get the choices the player can actually pick

    Arguments:
        scene: current scene
        state: current game state

    Returns:
        list: choices the player is allowed to use

    Author: Balfour
        
    """
    good_choices = []

    for choice in scene["choices"]:
        if requirements_met(choice, state):
            good_choices.append(choice)

    return good_choices
    
    
def show_scene(scene, state):
    """
    Purpose:
        show the current scene text and stats

    Arguments:
        scene: current scene
        state: current game state

    Returns:
        none

    Author: Coogan
        
    """
    print("=" * 50)
    print(scene["text"])
    state.show_stats()
    
    
def show_choices(choices):
    """
    Purpose:
        print all the choices for the user

    Arguments:
        choices: list of current choices

    Returns:
        none

    Author: Antil
        
    """
    for i in range(len(choices)):
        print(str(i + 1) + ".", choices[i]["label"])
    
    
def get_user_choice(choices):
    """
    Purpose:
        get the user's choice input

    Arguments:
        choices: list of current choices

    Returns:
        dict: the choice the user picked

    Author: Balfour
        
    """
    while True:
       pick = input("Pick a choice: ").strip()

       if pick.isdigit():
            pick = int(pick)
            if 1 <= pick <= len(choices):
                return choices[pick - 1]

       print("Invalid choice.")
    
    
def apply_choice(choice, state):
    """
    Purpose:
        apply the picked choice to the game state

    Arguments:
        choice: selected choice
        state: current game state

    Returns:
        none

    Author: Coogan
        
    """
    if "delta" in choice:
        delta = choice["delta"]

        state.risk += delta.get("risk", 0)
        state.progress += delta.get("progress", 0)
        state.resources += delta.get("resources", 0)

    if "flags_set" in choice:
        for key, value in choice["flags_set"].items():
            state.flags[key] = value

    state.history.append(choice["label"])
    state.scene_id = choice["next"]
    
    
def check_game_end(state):
    """
    Purpose:
        check if the game is won or lost

    Arguments:
        state: current game state

    Returns:
        str or None: win, lose, or none

    Author: Antil
        
    """
    if state.risk > 6:
        return "lose"

    if state.resources <= 0:
        return "lose"

    if state.progress >= 7 and state.risk <= 6 and state.resources > 0:
        return "win"

    return None
    
    
def show_ending(result, state):
    """
    Purpose:
        show the ending and final stats

    Arguments:
        result: win or lose
        state: current game state

    Returns:
        none

    Author: Balfour
        
    """
    print()
    print("=" * 50)

    if result == "win":
        print("You got away with the heist.")
    else:
        print("The heist failed.")

    print()
    print("Final stats")
    print("Risk:", state.risk)
    print("Progress:", state.progress)
    print("Resources:", state.resources)
    print()
    print("History:")

    for item in state.history:
        print("-", item)
    
    
