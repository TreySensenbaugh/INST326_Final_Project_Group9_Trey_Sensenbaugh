def run_game():
    """
    Purpose:
        run the main game loop

    Arguments:
        none

    Returns:
        none

    Author: Sensenbaugh
        
    """
    scenes = load_scenes("scenes.json")
    state = GameState("START")

    while True:
        scene = get_scene_by_id(scenes, state.scene_id)

        if scene is None:
            print("Scene not found.")
            break

        show_scene(scene, state)

        choices = get_choices(scene, state)

        if len(choices) == 0:
            print("No more choices.")
            show_ending("lose", state)
            break

        show_choices(choices)
        chosen = get_user_choice(choices)
        apply_choice(chosen, state)

        result = check_game_end(state)

        if result is not None:
            show_ending(result, state)
            break
    
    
if __name__ == "__main__":
    run_game()